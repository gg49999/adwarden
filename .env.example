# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID (General Information -> Application ID)
CLIENT_ID=
# Optional: a server ID for instant slash-command registration while testing.
# Leave empty to register globally (can take up to an hour to appear).
DEV_GUILD_ID=
# SQLite file path (relative to prisma/). For Postgres use postgresql://user:pass@host:5432/adwarden
DATABASE_URL=file:./adwarden.db
# Optional remote phishing-domain list (JSON array of domains or {"domains":[...]}, or newline text).
# Example: https://raw.githubusercontent.com/nikolaischunk/discord-phishing-links/main/domain-list.json
SCAM_LIST_URL=
# debug | info | warn | error
LOG_LEVEL=info
# Register slash commands each time the bot starts (set to false to manage with npm run deploy)
DEPLOY_ON_START=true
